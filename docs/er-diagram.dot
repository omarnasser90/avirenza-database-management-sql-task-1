  test_results [label=<<TABLE BORDER="1" COLOR="#C4D2E0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD COLSPAN="3" BGCOLOR="#174F79" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="16"><B>test_results</B></FONT></TD></TR><TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#25384B">result_id</FONT></TD><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#53687B" POINT-SIZE="10">INT</FONT></TD><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#A05D0A" POINT-SIZE="10"><B>PK​</B></FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#25384B">test_id</FONT></TD><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#53687B" POINT-SIZE="10">INT</FONT></TD><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#A05D0A" POINT-SIZE="10"><B>FK​</B></FONT></TD></TR><TR><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#25384B">enrollment_id</FONT></TD><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#53687B" POINT-SIZE="10">INT</FONT></TD><TD BGCOLOR="#F1F5F9" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#A05D0A" POINT-SIZE="10"><B>FK​</B></FONT></TD></TR><TR><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#25384B">marks</FONT></TD><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#53687B" POINT-SIZE="10">DECIMAL(6,2)</FONT></TD><TD BGCOLOR="white" ALIGN="LEFT" CELLPADDING="6"><FONT COLOR="#A05D0A" POINT-SIZE="10"><B>CHECK​</B></FONT></TD></TR></TABLE>>];
